{
  "name": "threejs-glb-game",
  "version": "1.0.0",
  "description": "A Three.js game that loads and displays GLB models",
  "main": "index.html",
  "scripts": {
    "start": "npx http-server -p 8080 -c-1",
    "dev": "npx http-server -p 8080 -c-1 -o",
    "optimize-glb": "node optimize-glb.js",
    "optimize-stadium": "npx @gltf-transform/cli optimize character/low_poly_stadium.glb character/low_poly_stadium_optimized.glb --texture-compress webp --resize-textures 2048 --draco"
  },
  "keywords": [
    "threejs",
    "glb",
    "3d",
    "game",
    "webgl"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@gltf-transform/cli": "^3.9.0",
    "@gltf-transform/core": "^3.9.0",
    "@gltf-transform/extensions": "^3.9.0",
    "@gltf-transform/functions": "^3.9.0",
    "http-server": "^14.1.1"
  }
}
